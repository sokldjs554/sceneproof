# RTSP camera simulator (gst-rtsp-server) serving the sample videos.
FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      gstreamer1.0-tools gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-plugins-bad \
      gstreamer1.0-rtsp gir1.2-gstreamer-1.0 gir1.2-gst-rtsp-server-1.0 python3-gi \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY src/zonewatch/tools/rtsp_sim.py ./rtsp_sim.py
EXPOSE 8554
ENTRYPOINT ["/usr/bin/python3", "rtsp_sim.py"]
CMD ["--dir", "/videos", "--port", "8554"]
